{
  "project": "hanzi_stroke_temporal_composition",
  "run_kind": "pilot",
  "variant": "fixed_duration_9task_pilot_v1",
  "timing_mode": "fixed_movement_duration",
  "seed": 42,
  "validation_seed": 1042,
  "device": "cpu",
  "geometry_config": "configurations/hanzi_stroke_temporal_composition_fixed_duration_geometry.json",
  "active_rules": ["heng", "shu", "pie", "na", "dian", "ti", "hengzhe", "shugou", "move"],
  "rule_dim_total": 10,
  "unused_rule_index": 9,
  "model": {
    "network": "rnn",
    "input_size": 28,
    "hidden_size": 256,
    "output_size": 6,
    "activation": "softplus",
    "recurrent_noise_std": 0.1,
    "input_noise_std": 0.01,
    "constrained": false,
    "rnn_dt_ms": 10,
    "rnn_tau_ms": 20,
    "batch_first": true
  },
  "optimizer": {
    "name": "Adam",
    "learning_rate": 0.001,
    "grad_clip_norm": 1.0
