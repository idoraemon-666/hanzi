    "delay_weight": 0.1,
    "movement_weight": 0.6,
    "hold_weight": 0.2
  },
  "regularization": {
    "l1_rate": 0.001,
    "l1_weight": 0.001,
    "l1_muscle_act": 0.01,
    "simple_dynamics_weight": 0.001
  },
  "output": {
    "directory": "runs/hanzi_stroke_temporal_composition/fixed_duration_pilot/dev42",
