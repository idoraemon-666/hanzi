{
  "project": "hanzi_stroke_temporal_composition",
  "run_kind": "dual_fixed_rule_multitask_loss_comparison",
  "variant": "dual_fixed_rule_loss_comparison_v1",
  "enabled": true,
  "seed": 42,
  "validation_seed": 1042,
  "device": "cpu",
  "geometry_config": "configurations/hanzi_stroke_temporal_composition_canonical_geometry.json",
  "timing": {
    "stable_steps": 25,
    "delay_steps": 50,
    "hold_steps": 25,
